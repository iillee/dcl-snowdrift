{
  "name": "snowdrift",
  "version": "0.1.0",
  "description": "Snow Drift — a cozy multiplayer survival hangout for Decentraland.",
  "scripts": {
    "start": "sdk-commands start",
    "deploy": "sdk-commands deploy",
    "build": "sdk-commands build",
    "server-logs": "sdk-commands sdk-server-logs",
    "auth-server": "npx --yes @dcl/hammurabi-server@next --realm=http://127.0.0.1:8000",
    "upgrade-sdk": "npm install --save-dev @dcl/sdk@auth-server",
    "upgrade-sdk:next": "npm install --save-dev @dcl/sdk@next"
  },
  "devDependencies": {
    "@dcl/js-runtime": "^7.26.1-32160454304.commit-3ce97c8",
    "@dcl/sdk": "^7.26.1-32160454304.commit-3ce97c8"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=6.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
  },
  "dependencies": {
    "@stom66/dcl-ui-component-kit": "^0.1.14"
  }
}
